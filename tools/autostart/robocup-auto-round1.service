[Unit]
Description=RoboCup first passing round on shared chassis/sensor power
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKSPACE@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @WORKSPACE@/tools/auto_round1.py --config @WORKSPACE@/tools/auto_round1.json
StateDirectory=robocup-auto-round1
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
