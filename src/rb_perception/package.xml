<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rb_perception</name>
  <version>0.1.0</version>
  <description>RoboCup 篮球机器人 · 视觉识别（球种 / 篮筐 / 传球架圆环 / 定位柱 / 干扰球）</description>
  <maintainer email="team@bupt.edu.cn">BUPT RobotTeam</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rb_msgs</depend>

  <!-- 测试依赖：colcon test 才会去跑 test/ 下的 pytest -->
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
