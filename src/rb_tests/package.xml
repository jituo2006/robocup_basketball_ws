<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rb_tests</name>
  <version>0.1.0</version>
  <description>RoboCup 篮球机器人 · 集成/系统测试（夹具 + 离线验证 + 硬件自检）</description>
  <maintainer email="team@bupt.edu.cn">BUPT RobotTeam</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rb_msgs</depend>
  <depend>rb_camera</depend>
  <depend>rb_perception</depend>
  <depend>rb_localization</depend>
  <depend>rb_mission</depend>

  <test_depend>python3-pytest</test_depend>
  <!-- test_launch_files.py 会把 rb_bringup 的 launch 展开，而那些 launch 要
       get_package_share_directory("rb_chassis"/"rb_launcher")，所以这三个
       必须声明，否则 colcon test 的隔离环境里找不到包、测试假失败。 -->
  <test_depend>rb_chassis</test_depend>
  <test_depend>rb_launcher</test_depend>
  <test_depend>rb_bringup</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
